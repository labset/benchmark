{
  "name": "@labset/benchmark-toolkit",
  "version": "1.0.0",
  "type": "module",
  "description": "API benchmark toolkit - capture build, deploy, and load test metrics",
  "license": "Apache-2.0",
  "author": "Hasnae R.",
  "bin": {
    "benchmark": "./bin/benchmark.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
