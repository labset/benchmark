{
  "targets": {},
  "defaults": {
    "k6": {
      "vus": 50,
      "duration": "30s"
    },
    "readinessProbe": {
      "initialDelayMs": 2000,
      "intervalMs": 1000,
      "timeoutMs": 120000
    }
  },
  "grafana": {
    "endpoint": "https://otlp-gateway-prod-us-central-0.grafana.net/otlp",
    "instanceId": "${GRAFANA_INSTANCE_ID}",
    "apiKey": "${GRAFANA_API_KEY}"
  },
  "output": {
    "dir": "./results"
  }
}
